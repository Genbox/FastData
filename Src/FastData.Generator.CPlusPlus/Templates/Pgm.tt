            lo = static_cast<size_t>(pos - <#= (Data.Epsilon + 1).ToStringInvariant() #>);
        size_t hi = static_cast<size_t>(pos) + <#= (Data.Epsilon + 3).ToStringInvariant() #>;
        if (hi > <#= Data.KeyCount.ToStringInvariant() #>) hi = <#= Data.KeyCount.ToStringInvariant() #>;

        while (lo < hi) {
            const size_t mid = lo + ((hi - lo) >> 1);
            const <#= KeyTypeName #> mid_key = key_items[mid];
            if (mid_key == <#= LookupKeyName #>)
                return true;
            if (mid_key < <#= LookupKeyName #>)
                lo = mid + 1;
            else
                hi = mid;
        }

        return false;
<#
    }
    else
    {
#>
        const int32_t pos = get_segment_pos(<#= LookupKeyName #>);

        size_t lo = 0;
        if (pos >= <#= (Data.Epsilon + 1).ToStringInvariant() #>)
            lo = static_cast<size_t>(pos - <#= (Data.Epsilon + 1).ToStringInvariant() #>);
        size_t hi = static_cast<size_t>(pos) + <#= (Data.Epsilon + 3).ToStringInvariant() #>;
        if (hi > <#= Data.KeyCount.ToStringInvariant() #>) hi = <#= Data.KeyCount.ToStringInvariant() #>;

        while (lo < hi) {
            const size_t mid = lo + ((hi - lo) >> 1);
            const <#= KeyTypeName #> mid_key = key_items[mid];
            if (mid_key == <#= LookupKeyName #>)
                return true;
            if (mid_key < <#= LookupKeyName #>)
                lo = mid + 1;
            else
                hi = mid;
