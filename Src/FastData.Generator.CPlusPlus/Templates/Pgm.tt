<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.PgmTemplateData" name="Data" #>

<#
    bool floatingKey = Model.KeyType == typeof(float) || Model.KeyType == typeof(double);
    string cppDiffExpr = floatingKey ? "(coordinate(key) - coordinate({0}))" : "(static_cast<uint64_t>(key) - static_cast<uint64_t>({0}))";
    bool singleSegment = Data.SegmentCount == 1;
    bool hasRecursiveLevels = Data.EpsilonRecursive > 0 && Data.LevelsOffsets.Length > 2;
    int linearSearchThreshold = 64;
    Type interceptType = !singleSegment && GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestSignedStorageType(Data.Segments.Min(x => x.Intercept), Data.Segments.Max(x => x.Intercept)) : typeof(int);

    string segKeyConst = singleSegment ? TypeMap.GetValueLiteral(Data.Segments[0].Key) : "";
    float seg0Slope = singleSegment ? Data.Segments[0].Slope : 0;
    int seg0Intercept = singleSegment ? Data.Segments[0].Intercept : 0;
    int seg0MaxProduct = singleSegment ? Math.Max(0, Data.KeyCount - seg0Intercept) : 0;

    Func<float, string> formatSlope = slope => TypeMap.GetValueLiteral(NumericPrediction.Coefficient(slope));

#>
<#@ include file="Includes\NumericPrediction.ttinclude" #>
<#
    if (Data.ValueCount > 0)
    {
#>
    <#= FieldModifier(false) #>std::array<<#= ValueTypeName #>, <#= Data.ValueCount.ToStringInvariant() #>> value_items = {
<#= FormatHelper.FormatColumns(Data.Values, Data.ValueCount, TypeMap.GetValueLiteral, 8) #>
    };
<#
    }
#>
    <#= FieldModifier(true) #>std::array<<#= KeyTypeName #>, <#= Data.KeyCount.ToStringInvariant() #>> key_items = {
<#= FormatHelper.FormatColumns(Data.Keys, Data.KeyCount, TypeMap.GetValueLiteral, 8) #>
    };
<#
    if (!singleSegment)
    {
#>

    <#= FieldModifier(true) #>std::array<<#= KeyTypeName #>, <#= Data.Segments.Length.ToStringInvariant() #>> seg_keys = {
<#= FormatHelper.FormatColumns(Data.Segments.Select(s => s.Key), Data.Segments.Length, TypeMap.GetValueLiteral, 8) #>
    };

    <#= FieldModifier(true) #>std::array<uint64_t, <#= Data.Segments.Length.ToStringInvariant() #>> seg_slopes = {
<#= FormatHelper.FormatColumns(Data.Segments.Select(s => (object)s.Slope), Data.Segments.Length, o => formatSlope((float)o), 8) #>
    };

    <#= FieldModifier(true) #>std::array<<#= TypeMap.GetTypeName(interceptType) #>, <#= Data.Segments.Length.ToStringInvariant() #>> seg_intercepts = {
<#= FormatHelper.FormatColumns(Data.Segments, x => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.Intercept, interceptType)), 8) #>
    };

    static <#= floatingKey ? "" : "constexpr " #>int32_t evaluate_segment(const size_t seg, const <#= KeyTypeName #> key) noexcept {
        const uint64_t product = multiply_high(seg_slopes[seg], <#= string.Format(cppDiffExpr, "seg_keys[seg]") #>);
        const int32_t intercept = static_cast<int32_t>(seg_intercepts[seg]);
        const int32_t max_product = <#= Data.KeyCount.ToStringInvariant() #> - intercept;
        return (product > static_cast<uint64_t>(max_product) ? max_product : static_cast<int32_t>(product)) + intercept;
    }

    static <#= floatingKey ? "" : "constexpr " #>int32_t get_segment_pos(const <#= KeyTypeName #> key) noexcept {
<#
        if (!hasRecursiveLevels)
        {
#>
        size_t seg = 0;
        size_t seg_hi = <#= (Data.SegmentCount - 1).ToStringInvariant() #>;
        while (seg < seg_hi) {
            const size_t mid = seg + ((seg_hi - seg) >> 1);
            if (seg_keys[mid + 1] <= key)
                seg = mid + 1;
            else
                seg_hi = mid;
        }

        int32_t pos = evaluate_segment(seg, key);
        const int32_t next_intercept = static_cast<int32_t>(seg_intercepts[seg + 1]);
        if (pos > next_intercept) pos = next_intercept;
        return pos;
<#
        }
        else
        {
            int rootSegOffset = Data.LevelsOffsets[Data.LevelsOffsets.Length - 2];
#>
        size_t seg = <#= rootSegOffset.ToStringInvariant() #>;
<#
            for (int level = Data.LevelsOffsets.Length - 3; level >= 0; level--)
            {
                int levelBegin = Data.LevelsOffsets[level];
                int levelEnd = Data.LevelsOffsets[level + 1];
                int levelSize = levelEnd - levelBegin - 1;
                int sentinel = levelEnd - 1;
                int epsRec = Data.EpsilonRecursive + 1;
                bool useBinarySearch = epsRec > linearSearchThreshold;
#>

        {
            int32_t pos = evaluate_segment(seg, key);
            const int32_t next_intercept = static_cast<int32_t>(seg_intercepts[seg + 1]);
            if (pos > next_intercept) pos = next_intercept;

            size_t lo = 0;
            if (pos > <#= (epsRec + 1).ToStringInvariant() #>)
                lo = static_cast<size_t>(pos - <#= (epsRec + 1).ToStringInvariant() #>);
<#
                if (useBinarySearch)
                {
#>

            size_t hi = static_cast<size_t>(pos) + <#= (epsRec + 2).ToStringInvariant() #>;
            if (hi > <#= levelSize.ToStringInvariant() #>) hi = <#= levelSize.ToStringInvariant() #>;

            seg = <#= levelBegin.ToStringInvariant() #> + lo;
            size_t seg_hi = <#= levelBegin.ToStringInvariant() #> + hi;
            while (seg < seg_hi) {
                const size_t mid = seg + ((seg_hi - seg) >> 1);
                if (seg_keys[mid + 1] <= key)
                    seg = mid + 1;
                else
                    seg_hi = mid;
            }
<#
                }
                else
                {
#>

            seg = <#= levelBegin.ToStringInvariant() #> + lo;
            while (seg + 1 < <#= sentinel.ToStringInvariant() #> && seg_keys[seg + 1] <= key)
                ++seg;
<#
                }
#>
        }
<#
            }
#>

        {
            int32_t pos = evaluate_segment(seg, key);
            const int32_t next_intercept = static_cast<int32_t>(seg_intercepts[seg + 1]);
            if (pos > next_intercept) pos = next_intercept;
            return pos;
        }
<#
        }
#>
    }
<#
    }
#>

