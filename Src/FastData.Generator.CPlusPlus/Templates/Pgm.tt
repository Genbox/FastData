        int32_t pos = <#= seg0Intercept.ToStringInvariant() #>;
<#
        }
        else
        {
#>
        const uint64_t product = multiply_high(<#= formatSlope(seg0Slope) #>, <#= string.Format(cppDiffExpr, segKeyConst) #>);
        int32_t pos = product > <#= seg0MaxProduct.ToStringInvariant() #>ULL ? <#= seg0MaxProduct.ToStringInvariant() #> : static_cast<int32_t>(product);
<#          if (seg0Intercept != 0) { #>
        pos += <#= seg0Intercept.ToStringInvariant() #>;
<#          } #>
        if (pos > <#= Data.KeyCount.ToStringInvariant() #>) pos = <#= Data.KeyCount.ToStringInvariant() #>;
<#
        }
#>

        size_t lo = 0;
