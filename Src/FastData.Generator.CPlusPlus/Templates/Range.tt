<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.RangeTemplateData" name="Data" #>

<#
    Type rangeType = GeneratorConfig.TypeReductionEnabled && Data.RangeCount > 1
        ? IntegralTypeReducer.GetSmallestStorageType(Model.KeyType, Data.Ranges[0].Start, Data.Ranges[^1].End)
        : Model.KeyType;
    string rangeTypeName = TypeMap.GetTypeName(rangeType);
    bool rangeTypeReduced = rangeType != Model.KeyType;
    Func<string, string> toKeyType = value => rangeTypeReduced ? $"static_cast<{KeyTypeName}>({value})" : value;

    if (Data.RangeCount > 1)
    {
#>
    <#= FieldModifier(true) #>std::array<<#= rangeTypeName #>, <#= Data.RangeCount.ToStringInvariant() #>> range_starts = {
<#= FormatHelper.FormatColumns(Data.Ranges, x => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.Start, rangeType)), 8) #>
    };

    <#= FieldModifier(true) #>std::array<<#= rangeTypeName #>, <#= Data.RangeCount.ToStringInvariant() #>> range_ends = {
<#= FormatHelper.FormatColumns(Data.Ranges, x => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.End, rangeType)), 8) #>
    };
<#
    }
#>
public:
<#
    if (Data.RangeCount == 1)
    {
#>    class key_iterator final {
        uint64_t _offset;

        static constexpr <#= KeyTypeName #> start = <#= TypeMap.GetValueLiteral(Data.Ranges[0].Start) #>;
        static constexpr <#= KeyTypeName #> end_key = <#= TypeMap.GetValueLiteral(Data.Ranges[0].End) #>;

    public:
        constexpr explicit key_iterator(const uint64_t offset) noexcept : _offset(offset) {}

        constexpr key_iterator& operator++() noexcept { ++_offset; return *this; }
        [[nodiscard]] constexpr bool operator!=(const key_iterator& other) const noexcept { return _offset != other._offset; }
        [[nodiscard]] constexpr <#= KeyTypeName #> operator*() const noexcept { return static_cast<<#= KeyTypeName #>>(start + _offset); }
        [[nodiscard]] static constexpr uint64_t count() noexcept { return static_cast<uint64_t>(end_key - start) + 1; }
    };
<#
    }
    else
    {
#>    class key_iterator final {
        size_t _range;
        <#= KeyTypeName #> _key;

    public:
        key_iterator(const size_t range, const <#= KeyTypeName #> key) noexcept : _range(range), _key(key) {}

        key_iterator& operator++() noexcept {
            if (_key == <#= toKeyType("range_ends[_range]") #>) {
                ++_range;
                if (_range < range_starts.size())
                    _key = <#= toKeyType("range_starts[_range]") #>;
            }
            else {
                ++_key;
            }

            return *this;
        }

        [[nodiscard]] bool operator!=(const key_iterator& other) const noexcept { return _range != other._range; }
        [[nodiscard]] <#= KeyTypeName #> operator*() const noexcept { return _key; }
    };
<#
    }
#>
    class key_range final {
    public:
<#
    if (Data.RangeCount == 1)
    {
#>        [[nodiscard]] constexpr key_iterator begin() const noexcept { return key_iterator(0); }
        [[nodiscard]] constexpr key_iterator end() const noexcept { return key_iterator(key_iterator::count()); }
<#
    }
    else
    {
#>        [[nodiscard]] key_iterator begin() const noexcept { return key_iterator(0, <#= toKeyType("range_starts[0]") #>); }
        [[nodiscard]] key_iterator end() const noexcept { return key_iterator(range_starts.size(), <#= TypeMap.GetValueLiteral(Data.Ranges[Data.RangeCount - 1].End) #>); }
<#
    }
#>    };

    [[nodiscard]]
    static <#= Data.RangeCount == 1 ? "constexpr " : "" #>key_range keys() noexcept { return key_range(); }

    <#= MethodAttribute #>
    <#= MethodModifier(true) #>bool contains(const <#= KeyTypeName #> key)<#= PostMethodModifier #> {
<#= GetMethodHeader(MethodType.Contains) #>
<#
    if (Data.RangeCount == 1)
    {
#>
        return <#= LookupKeyName #> >= <#= TypeMap.GetValueLiteral(Data.Ranges[0].Start) #> && <#= LookupKeyName #> <= <#= TypeMap.GetValueLiteral(Data.Ranges[0].End) #>;
<#
    }
    else if (Data.RangeCount < 8)
    {
#>
        for (size_t i = 0; i < <#= Data.RangeCount.ToStringInvariant() #>; ++i) {
            if (<#= LookupKeyName #> < <#= toKeyType("range_starts[i]") #>)
                return false;

            if (<#= LookupKeyName #> <= <#= toKeyType("range_ends[i]") #>)
                return true;
        }

        return false;
<#
    }
    else
    {
#>
        size_t low = 0;
        size_t high = <#= Data.RangeCount.ToStringInvariant() #>;

        while (low < high) {
            const size_t middle = low + ((high - low) >> 1);

            if (<#= LookupKeyName #> < <#= toKeyType("range_starts[middle]") #>)
                high = middle;
            else
                low = middle + 1;
        }

        if (low == 0)
            return false;

        return <#= LookupKeyName #> <= <#= toKeyType("range_ends[low - 1]") #>;
<#
    }
#>
    }
<#@ include file="Includes\Footer.ttinclude" #>