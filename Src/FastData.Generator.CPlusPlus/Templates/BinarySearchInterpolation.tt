public:
<#= ArrayAccessProperties("key_items", Data.KeyCount, "value_items", Data.ValueCount) #>
    <#= MethodAttribute #>
    <#= MethodModifier(true) #>bool contains(const <#= KeyTypeName #> key)<#= PostMethodModifier #> {
