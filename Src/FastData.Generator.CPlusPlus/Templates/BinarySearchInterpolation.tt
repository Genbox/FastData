<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.BinarySearchTemplateData" name="Data" #>

<#
    if (Data.ValueCount > 0)
    {
#>
    <#= FieldModifier(false) #>std::array<<#= ValueTypeName #>, <#= Data.ValueCount.ToStringInvariant() #>> value_items = {
<#= FormatHelper.FormatColumns(Data.Values, Data.ValueCount, TypeMap.GetValueLiteral, 8) #>
    };
<#
    }
#>
    <#= FieldModifier(true) #>std::array<<#= KeyTypeName #>, <#= Data.KeyCount.ToStringInvariant() #>> key_items = {
<#= FormatHelper.FormatColumns(Data.Keys, Data.KeyCount, TypeMap.GetValueLiteral, 8) #>
    };

public:
<#= ArrayAccessProperties("key_items", Data.KeyCount, "value_items", Data.ValueCount) #>
    <#= MethodAttribute #>
    <#= MethodModifier(true) #>bool contains(const <#= KeyTypeName #> key)<#= PostMethodModifier #> {
<#= GetMethodHeader(MethodType.Contains) #>
        int32_t lo = 0;
        int32_t hi = <#= (Data.KeyCount - 1).ToStringInvariant() #>;
        while (lo <= hi && <#= LookupKeyName #> >= key_items[lo] && <#= LookupKeyName #> <= key_items[hi]) {
            const <#= KeyTypeName #> lo_key = key_items[lo];
            const <#= KeyTypeName #> hi_key = key_items[hi];

            if (lo_key == hi_key) {
                if (lo_key == <#= LookupKeyName #>)
                    return true;

                break;
            }

            const double lo_value = static_cast<double>(lo_key);
            const double hi_value = static_cast<double>(hi_key);
            int32_t mid = lo + ((hi - lo) >> 1);

            if (lo_value != hi_value) {
                const double estimate = ((static_cast<double>(<#= LookupKeyName #>) - lo_value) * (hi - lo)) / (hi_value - lo_value);
                if (estimate >= 0.0 && estimate <= static_cast<double>(hi - lo))
                    mid = lo + static_cast<int32_t>(estimate);
            }

            if (mid < lo)
                mid = lo;
            else if (mid > hi)
                mid = hi;

            const <#= KeyTypeName #> mid_key = key_items[mid];
            if (mid_key == <#= LookupKeyName #>)
                return true;
            if (mid_key < <#= LookupKeyName #>)
                lo = mid + 1;
            else
                hi = mid - 1;
        }

        return false;
    }
<#
    if (Data.ValueCount > 0)
    {
#>

    <#= MethodAttribute #>
    <#= MethodModifier(false) #>bool try_lookup(const <#= KeyTypeName #> key, const <#= ValueTypeName #>*& value)<#= PostMethodModifier #> {
<#= GetMethodHeader(MethodType.TryLookup) #>
        int32_t lo = 0;
        int32_t hi = <#= (Data.KeyCount - 1).ToStringInvariant() #>;
        while (lo <= hi && <#= LookupKeyName #> >= key_items[lo] && <#= LookupKeyName #> <= key_items[hi]) {
            const <#= KeyTypeName #> lo_key = key_items[lo];
            const <#= KeyTypeName #> hi_key = key_items[hi];

            if (lo_key == hi_key) {
                if (lo_key == <#= LookupKeyName #>) {
                    value = &value_items[lo];
                    return true;
                }

                break;
            }

            const double lo_value = static_cast<double>(lo_key);
            const double hi_value = static_cast<double>(hi_key);
            int32_t mid = lo + ((hi - lo) >> 1);

            if (lo_value != hi_value) {
                const double estimate = ((static_cast<double>(<#= LookupKeyName #>) - lo_value) * (hi - lo)) / (hi_value - lo_value);
                if (estimate >= 0.0 && estimate <= static_cast<double>(hi - lo))
                    mid = lo + static_cast<int32_t>(estimate);
            }

            if (mid < lo)
                mid = lo;
            else if (mid > hi)
                mid = hi;

            const <#= KeyTypeName #> mid_key = key_items[mid];
            if (mid_key == <#= LookupKeyName #>) {
                value = &value_items[mid];
                return true;
            }

            if (mid_key < <#= LookupKeyName #>)
                lo = mid + 1;
            else
                hi = mid - 1;
        }

        value = nullptr;
        return false;
    }
<#
    }
#>
<#@ include file="Includes\Footer.ttinclude" #>