            return false;
        }
        const uint64_t first_offset = multiply_high((<#= coordinate(LookupKeyName) #> - <#= TypeMap.GetValueLiteral(NumericPrediction.Coordinate(Data.Keys.First())) #>) << <#= 32 - shift #>, <#= TypeMap.GetValueLiteral(firstReciprocal) #>);
        const int32_t first = first_offset > static_cast<uint64_t>(hi) ? hi : static_cast<int32_t>(first_offset);
        const <#= KeyTypeName #> first_key = key_items[first];
        if (first_key == <#= LookupKeyName #>) {
            return true;
        }
        if (first_key < <#= LookupKeyName #>) lo = first + 1;
        else hi = first - 1;
<# } #>
        while (lo <= hi && <#= LookupKeyName #> >= key_items[lo] && <#= LookupKeyName #> <= key_items[hi]) {
            const <#= KeyTypeName #> lo_key = key_items[lo];
            const <#= KeyTypeName #> hi_key = key_items[hi];

            if (lo_key == hi_key) {
                if (lo_key == <#= LookupKeyName #>)
                    return true;

                break;
            }

            const uint64_t range = <#= coordinate("hi_key") #> - <#= coordinate("lo_key") #>;
            const uint64_t delta = <#= coordinate(LookupKeyName) #> - <#= coordinate("lo_key") #>;
            const uint64_t normalized_range = range >> <#= shift #>;
            int32_t mid;
            if (normalized_range < static_cast<uint64_t>(hi - lo))
                mid = lo + ((hi - lo) >> 1);
            else {
                const uint64_t reciprocal = (static_cast<uint64_t>(hi - lo) << 32) / normalized_range + 1;
                const uint64_t offset = multiply_high(delta << <#= 32 - shift #>, reciprocal);
                mid = offset > static_cast<uint64_t>(hi - lo) ? hi : lo + static_cast<int32_t>(offset);
            }

            const <#= KeyTypeName #> mid_key = key_items[mid];
            if (mid_key == <#= LookupKeyName #>)
                return true;
            if (mid_key < <#= LookupKeyName #>)
                lo = mid + 1;
            else
                hi = mid - 1;
        }

        return false;
    }
