<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generators.Contexts.HashTableCompactContext" name="Context" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.HashTableCompactTemplateData" name="Data" #>

<#
    string[] valueLabels = Data.Values.Select(TypeMap.GetValueLiteral).ToArray();
    Type indexType = GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestUnsignedStorageType((ulong)Context.BucketStarts.Max()) : typeof(uint);
    Type hashType = Context.StoreHashCode && GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestUnsignedStorageType(Data.Entries.Max(x => x.Hash)) : typeof(ulong);
#>
    struct e {
        <#= KeyTypeName #> key;
<#
    if (Context.StoreHashCode)
    {
#>        <#= TypeMap.GetTypeName(hashType) #> hash_code;
<#
    }
    if (Data.ValueCount > 0)
    {
#>        const <#= ValueTypeName #> value;
<#
    }
#>        e(const <#= KeyTypeName #> key<#
    if (Context.StoreHashCode)
    {
#>, const <#= TypeMap.GetTypeName(hashType) #> hash_code<#
    }
    if (Data.ValueCount > 0)
    {
#>, const <#= ValueTypeName #> value<#
    }
#>)
           : key(key)<#
    if (Context.StoreHashCode)
    {
#>, hash_code(hash_code)<#
    }
    if (Data.ValueCount > 0)
    {
#>, value(value)<#
    }
#> {}
    };

    <#= FieldModifier(true) #>std::array<<#= TypeMap.GetTypeName(indexType) #>, <#= Context.BucketStarts.Length.ToStringInvariant() #>> bucket_starts = {
<#= FormatHelper.FormatColumns(Context.BucketStarts, x => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x, indexType)), 8) #>
    };

    <#= FieldModifier(false) #>std::array<e, <#= Data.Entries.Length.ToStringInvariant() #>> entries = {
<#= FormatHelper.FormatColumns(Data.Entries, (i, x) =>
    {
        string hashPart = Context.StoreHashCode ? $", {TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.Hash, hashType))}" : string.Empty;
        string valuePart = Data.ValueCount > 0 ? $", {valueLabels[i]}" : string.Empty;
        return $"e({TypeMap.GetValueLiteral(x.Key)}{hashPart}{valuePart})";
    }, 8) #>
    };

<#= HashSource #>

public:
<#= EntryIterators("e", "entries", "_entry->key", "_entry->value", Data.ValueCount) #>

    <#= MethodAttribute #>
    <#= MethodModifier(true) #>bool contains(const <#= KeyTypeName #> key)<#= PostMethodModifier #> {
<#= GetMethodHeader(MethodType.Contains) #>
        const uint64_t hash = <#= HashCall #>;
        const size_t index = <#= GetMod("hash", (ulong)(Context.BucketStarts.Length - 1)) #>;
        const size_t start = static_cast<size_t>(bucket_starts[index]);
        const size_t end = static_cast<size_t>(bucket_starts[index + 1]);

        for (size_t i = start; i < end; i++) {
            const auto& entry = entries[i];

            if (<#
    if (Context.StoreHashCode)
    {
#>static_cast<uint64_t>(entry.hash_code) == hash && <#
    }
#><#= GetEqual("entry.key", LookupKeyName) #>)
                return true;
        }

        return false;
    }
<#
    if (Data.ValueCount > 0)
    {
#>

    <#= MethodAttribute #>
    <#= MethodModifier(false) #>bool try_lookup(const <#= KeyTypeName #> key, const <#= ValueTypeName #>*& value)<#= PostMethodModifier #> {
<#= GetMethodHeader(MethodType.TryLookup) #>
        const uint64_t hash = <#= HashCall #>;
        const size_t index = <#= GetMod("hash", (ulong)(Context.BucketStarts.Length - 1)) #>;
        const size_t start = static_cast<size_t>(bucket_starts[index]);
        const size_t end = static_cast<size_t>(bucket_starts[index + 1]);

        for (size_t i = start; i < end; i++) {
            const auto& entry = entries[i];

            if (<#
        if (Context.StoreHashCode)
        {
#>static_cast<uint64_t>(entry.hash_code) == hash && <#
        }
#><#= GetEqual("entry.key", LookupKeyName) #>) {
                value = &entry.value;
                return true;
            }
        }

        value = nullptr;
        return false;
    }
<#
    }
#>
<#@ include file="Includes\Footer.ttinclude" #>