<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generators.Contexts.HashTableContext" name="Context" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.HashTableTemplateData" name="Data" #>

<#
    string[] valueLabels = Data.Values.Select(TypeMap.GetValueLiteral).ToArray();
    Type bucketType = GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestUnsignedStorageType((ulong)Context.Buckets.Max()) : typeof(int);
    Type nextType = GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestSignedStorageType(-1, Data.Entries.Max(x => x.Next)) : typeof(int);
    Type hashType = Context.StoreHashCode && GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestUnsignedStorageType(Data.Entries.Max(x => x.Hash)) : typeof(ulong);
#>
    struct e {
        <#= KeyTypeName #> key;
        <#= TypeMap.GetTypeName(nextType) #> next;
<#
    if (Context.StoreHashCode)
    {
#>        <#= TypeMap.GetTypeName(hashType) #> hash_code;
<#
    }
    if (Data.ValueCount > 0)
    {
#>        const <#= ValueTypeName #> value;
<#
    }
#>        e(const <#= KeyTypeName #> key, const <#= TypeMap.GetTypeName(nextType) #> next<#
    if (Context.StoreHashCode)
    {
#>, const <#= TypeMap.GetTypeName(hashType) #> hash_code<#
    }
    if (Data.ValueCount > 0)
    {
#>, const <#= ValueTypeName #> value<#
    }
#>)
           : key(key), next(next)<#
    if (Context.StoreHashCode)
    {
#>, hash_code(hash_code)<#
    }
    if (Data.ValueCount > 0)
    {
#>, value(value)<#
    }
#> {}
    };

    <#= FieldModifier(true) #>std::array<<#= TypeMap.GetTypeName(bucketType) #>, <#= Context.Buckets.Length.ToStringInvariant() #>> buckets = {
<#= FormatHelper.FormatColumns(Context.Buckets, x => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x, bucketType)), 8) #>
    };

    <#= FieldModifier(false) #>std::array<e, <#= Data.Entries.Length.ToStringInvariant() #>> entries = {
<#= FormatHelper.FormatColumns(Data.Entries, (i, x) =>
    {
        string hashPart = Context.StoreHashCode ? $", {TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.Hash, hashType))}" : string.Empty;
        string valuePart = Data.ValueCount > 0 ? $", {valueLabels[i]}" : string.Empty;
        return $"e({TypeMap.GetValueLiteral(x.Key)}, {TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.Next, nextType))}{hashPart}{valuePart})";
    }, 8) #>
    };

<#= HashSource #>

public:
<#= EntryIterators("e", "entries", "_entry->key", "_entry->value", Data.ValueCount) #>

    <#= MethodAttribute #>
    <#= MethodModifier(true) #>bool contains(const <#= KeyTypeName #> key)<#= PostMethodModifier #> {
<#= GetMethodHeader(MethodType.Contains) #>
        const uint64_t hash = <#= HashCall #>;
        const size_t index = <#= GetMod("hash", (ulong)Context.Buckets.Length) #>;
        int32_t i = static_cast<int32_t>(buckets[index]) - 1;

        while (i >= 0) {
            const auto& entry = entries[i];

            if (<#
    if (Context.StoreHashCode)
    {
#>static_cast<uint64_t>(entry.hash_code) == hash && <#
    }
#><#= GetEqual("entry.key", LookupKeyName) #>)
                return true;

            i = entry.next;
        }

        return false;
    }
<#
    if (Data.ValueCount > 0)
    {
#>

    <#= MethodAttribute #>
    <#= MethodModifier(false) #>bool try_lookup(const <#= KeyTypeName #> key, const <#= ValueTypeName #>*& value)<#= PostMethodModifier #> {
<#= GetMethodHeader(MethodType.TryLookup) #>
        const uint64_t hash = <#= HashCall #>;
        const size_t index = <#= GetMod("hash", (ulong)Context.Buckets.Length) #>;
        int32_t i = static_cast<int32_t>(buckets[index]) - 1;

        while (i >= 0) {
            const auto& entry = entries[i];

            if (<#
        if (Context.StoreHashCode)
        {
#>static_cast<uint64_t>(entry.hash_code) == hash && <#
        }
#><#= GetEqual("entry.key", LookupKeyName) #>) {
                value = &entry.value;
                return true;
            }

            i = entry.next;
        }

        value = nullptr;
        return false;
    }
<#
    }
#>
<#@ include file="Includes\Footer.ttinclude" #>