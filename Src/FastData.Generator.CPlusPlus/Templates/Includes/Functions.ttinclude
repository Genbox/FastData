<#+
    public string KeyTypeName => TypeMap.GetTypeName(Model.KeyType);
    public string ValueTypeName => TypeMap.GetTypeName(Model.ValueType);

    public string FieldModifier(bool constExpr) => constExpr ? "static constexpr " : "inline static const ";
    public string MethodModifier(bool constExpr) => constExpr ? "static constexpr " : "static ";
    public string MethodAttribute => "[[nodiscard]]";
    public string PostMethodModifier => " noexcept";
    public string LookupKeyName => "key";
    public string HashCall => Type.GetTypeCode(Model.KeyType) == TypeCode.String ? $"get_hash({LookupKeyName}, length)" : $"get_hash({LookupKeyName})";
    public string KeyDirectAccessProperty(string fieldName, int count) =>
        $$"""
        {{MethodAttribute}}
            static constexpr direct_access_view<{{KeyTypeName}}> keys() noexcept { return direct_access_view<{{KeyTypeName}}>({{fieldName}}.data(), {{count.ToStringInvariant()}}); }
        """;

    public string ValueDirectAccessProperty(string fieldName, int count) =>
        $$"""
        {{MethodAttribute}}
            static direct_access_view<{{ValueTypeName}}> values() noexcept { return direct_access_view<{{ValueTypeName}}>({{fieldName}}.data(), {{count.ToStringInvariant()}}); }
        """;

    public string ArrayAccessProperties(string keyField, int keyCount, string valueField, int valueCount)
    {
        string result = $"    {KeyDirectAccessProperty(keyField, keyCount)}";
        if (valueCount > 0)
            result += $"\n\n    {ValueDirectAccessProperty(valueField, valueCount)}";
        return result;
    }

    private string EntryIteratorPair(string name, string entryTypeName, string arrayName, string typeName, string deref) =>
        $$"""
            class {{name}}_iterator final {
                const {{entryTypeName}}* _entry;

            public:
                explicit {{name}}_iterator(const {{entryTypeName}}* entry) noexcept : _entry(entry) {}

                {{name}}_iterator& operator++() noexcept { ++_entry; return *this; }
                [[nodiscard]] bool operator!=(const {{name}}_iterator& other) const noexcept { return _entry != other._entry; }
                [[nodiscard]] const {{typeName}}& operator*() const noexcept { return {{deref}}; }
            };

            class {{name}}_range final {
            public:
                [[nodiscard]] {{name}}_iterator begin() const noexcept { return {{name}}_iterator({{arrayName}}.data()); }
                [[nodiscard]] {{name}}_iterator end() const noexcept { return {{name}}_iterator({{arrayName}}.data() + {{arrayName}}.size()); }
            };

            [[nodiscard]]
            static {{name}}_range {{name}}s() noexcept { return {{name}}_range(); }
        """;

    public string EntryIterators(string entryTypeName, string arrayName, string keyDeref, string valueDeref, int valueCount) =>
        valueCount > 0
            ? EntryIteratorPair("key", entryTypeName, arrayName, KeyTypeName, keyDeref)
              + "\n"
              + EntryIteratorPair("value", entryTypeName, arrayName, ValueTypeName, valueDeref)
            : EntryIteratorPair("key", entryTypeName, arrayName, KeyTypeName, keyDeref);

    public string HashSource
    {
        get
        {
            string parameters = Type.GetTypeCode(Model.KeyType) == TypeCode.String ? $"const {KeyTypeName} value, int32_t length" : $"const {KeyTypeName} value";

            return $$"""
                                        {{GetHashModifier()}}uint64_t get_hash({{parameters}}) noexcept {
                                    {{GetHash()}}
                                        }
                                    """;
        }
    }

    public string GetEqual(string var1, string var2)
    {
        if (GeneratorConfig is StringGeneratorConfig strCfg && strCfg.IgnoreCase)
            return $"case_insensitive_equals({var1}, {var2})";

        return $"{var1} == {var2}";
    }

    public string GetCompare(string var1, string var2)
    {
        if (GeneratorConfig is StringGeneratorConfig strCfg)
            return strCfg.IgnoreCase ? $"case_insensitive_compare({var1}, {var2})" : $"{var1}.compare({var2})";

        return $"{var1} < {var2} ? -1 : ({var1} > {var2} ? 1 : 0)";
    }

    public string GetMod(string var1, ulong var2) => $"{var1} % {var2.ToStringInvariant()}";

    public string GetMethodHeader(MethodType methodType) => GetEarlyExits(methodType, GeneratorConfig.EarlyExits);

    private string GetHashModifier()
    {
        TypeCode keyType = Type.GetTypeCode(Model.KeyType);
        return keyType is TypeCode.Single or TypeCode.Double or TypeCode.Int64 or TypeCode.UInt64 ? "static " : "static constexpr ";
    }

    private string GetEarlyExits(MethodType methodType, AnnotatedExpr[] earlyExits)
    {
        IEnumerable<AnnotatedExpr> transformed = ExpressionHelper.Transform(earlyExits, [new EarlyExitConditionTransform(GetBody(methodType))]);

        List<ParameterExpression> variables = new List<ParameterExpression>();
        List<Expression> statements = new List<Expression>();

        foreach (AnnotatedExpr expr in transformed)
        {
            if (expr.Kind == ExprKind.Assignment && expr.Expression is BinaryExpression { NodeType: ExpressionType.Assign, Left: ParameterExpression left })
                variables.Add(left);

            statements.Add(expr.Expression);
        }

        CPlusPlusExpressionCompiler compiler = new CPlusPlusExpressionCompiler(TypeMap);
        BlockExpression block = Expression.Block(variables, statements);
        return block.Expressions.Count == 0 ? string.Empty : compiler.GetCode(block, 8);
    }

    private string GetHash()
    {
        TypeCode keyType = Type.GetTypeCode(Model.KeyType);

        if (keyType.UsesIdentityHash())
            return "        return static_cast<uint64_t>(value);";

        if (GeneratorConfig is StringGeneratorConfig strCfg && strCfg.HashInfo != null)
        {
            CPlusPlusExpressionCompiler compiler = new CPlusPlusExpressionCompiler(TypeMap);
            return $"""
                           const auto data = value;
                   {compiler.GetCode(strCfg.HashInfo.Expression, 8)}
                           return hash;
                   """;
        }

        if (GeneratorConfig is NumericGeneratorConfig numCfg)
        {
            if (keyType == TypeCode.Single)
            {
                return numCfg.HasZero
                    ? """
                                uint32_t bits;
                                std::memcpy(&bits, &value, sizeof(bits));
                                if (((bits - 1) & ~0x80000000u) >= 0x7F800000u)
                                    bits &= 0x7F800000u;
                                return bits;
                        """
                    : """
                                uint32_t bits;
                                std::memcpy(&bits, &value, sizeof(bits));
                                return bits;
                        """;
            }

            if (keyType == TypeCode.Double)
            {
                return numCfg.HasZero
                    ? """
                                uint64_t bits;
                                std::memcpy(&bits, &value, sizeof(bits));
                                if (((bits - 1) & ~0x8000000000000000ull) >= 0x7FF0000000000000ull)
                                    bits &= 0x7FF0000000000000ull;
                                return bits;
                        """
                    : """
                                uint64_t bits;
                                std::memcpy(&bits, &value, sizeof(bits));
                                return bits;
                        """;
            }
        }

        throw new InvalidOperationException("Unsupported key type: " + keyType);
    }

    private static ICollection<Expression> GetBody(MethodType methodType) => methodType == MethodType.TryLookup
        ? [Expression.Assign(Symbol("value"), Symbol("nullptr")),ReturnSymbol("false")]
        : [ReturnSymbol("false")];

    private static ParameterExpression Symbol(string name) => Expression.Parameter(typeof(object), name);

    private static GotoExpression ReturnSymbol(string symbol)
    {
        ParameterExpression value = Symbol(symbol);
        LabelTarget target = Expression.Label(value.Type);
        return Expression.MakeGoto(GotoExpressionKind.Break, target, value, value.Type);
    }
#>