#else
        const uint64_t p00 = (a & 0xffffffffULL) * (b & 0xffffffffULL);
        const uint64_t p01 = (a & 0xffffffffULL) * (b >> 32);
        const uint64_t p10 = (a >> 32) * (b & 0xffffffffULL);
        const uint64_t p11 = (a >> 32) * (b >> 32);
        const uint64_t carry = ((p00 >> 32) + (p01 & 0xffffffffULL) + (p10 & 0xffffffffULL)) >> 32;
        return p11 + (p01 >> 32) + (p10 >> 32) + carry;
#endif
    }
