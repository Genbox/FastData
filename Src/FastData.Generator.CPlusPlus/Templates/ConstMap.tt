<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generators.Contexts.ConstMapContext" name="Context" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.ConstMapTemplateData" name="Data" #>

<#
    string[] valueLabels = Data.Values.Select(TypeMap.GetValueLiteral).ToArray();
    bool useEntryStruct = Data.ValueCount > 0;
    string entryTypeName = useEntryStruct ? "e" : KeyTypeName;
    Type dataType = GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestUnsignedStorageType(Context.Data.Max()) : typeof(uint);
#>
<#
    if (useEntryStruct)
    {
#>    struct e {
        <#= KeyTypeName #> key;
        const <#= ValueTypeName #> value;

        constexpr e(const <#= KeyTypeName #> key, const <#= ValueTypeName #> value)<#= PostMethodModifier #>
           : key(key), value(value) {}
    };
<#
    }
#>

    <#= FieldModifier(false) #>std::array<<#= entryTypeName #>, <#= Data.KeyCount.ToStringInvariant() #>> entries = {
<#= FormatHelper.FormatColumns(Data.Keys, Data.KeyCount, (i, x) =>
    {
        if (!useEntryStruct)
            return TypeMap.GetValueLiteral(x);

        return $"e({TypeMap.GetValueLiteral(x)}, {valueLabels[i]})";
    }, 8) #>
    };

    <#= FieldModifier(false) #>std::array<<#= TypeMap.GetTypeName(dataType) #>, <#= Context.Data.Length.ToStringInvariant() #>> data = {
<#= FormatHelper.FormatColumns(Context.Data, (_, x) => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x, dataType)), 8) #>
    };

    static constexpr uint64_t murmur64(uint64_t hash) noexcept {
        hash ^= hash >> 33;
        hash *= 0xff51afd7ed558ccdULL;
        hash ^= hash >> 33;
        hash *= 0xc4ceb9fe1a85ec53ULL;
        hash ^= hash >> 33;
        return hash;
    }

<#= HashSource #>

public:
    <#= MethodAttribute #>
    <#= MethodModifier(true) #>bool contains(const <#= KeyTypeName #> key)<#= PostMethodModifier #> {
<#= GetMethodHeader(MethodType.Contains) #>
        const uint64_t hash = murmur64(<#= HashCall #> + <#= Context.Seed.ToStringInvariant() #>ULL);
        const uint32_t h0 = static_cast<uint32_t>(static_cast<__uint128_t>(hash) * <#= Context.SegmentCountLength.ToStringInvariant() #>ULL >> 64);
        const uint32_t h1 = (h0 + <#= Context.SegmentLength.ToStringInvariant() #>U) ^ (static_cast<uint32_t>(hash >> 18) & <#= (Context.SegmentLength - 1).ToStringInvariant() #>U);
        const uint32_t h2 = (h0 + (2U * <#= Context.SegmentLength.ToStringInvariant() #>U)) ^ (static_cast<uint32_t>(hash) & <#= (Context.SegmentLength - 1).ToStringInvariant() #>U);
        const uint32_t candidate = static_cast<uint32_t>(data[h0]) ^ static_cast<uint32_t>(data[h1]) ^ static_cast<uint32_t>(data[h2]);

        if (candidate >= <#= Data.KeyCount.ToStringInvariant() #>U)
            return false;

        const auto& entry = entries[candidate];
        return <#= GetEqual(LookupKeyName, useEntryStruct ? "entry.key" : "entry") #>;
    }
<#
    if (Data.ValueCount > 0)
    {
#>

    <#= MethodAttribute #>
    <#= MethodModifier(false) #>bool try_lookup(const <#= KeyTypeName #> key, const <#= ValueTypeName #>*& value)<#= PostMethodModifier #> {
<#= GetMethodHeader(MethodType.TryLookup) #>
        const uint64_t hash = murmur64(<#= HashCall #> + <#= Context.Seed.ToStringInvariant() #>ULL);
        const uint32_t h0 = static_cast<uint32_t>(static_cast<__uint128_t>(hash) * <#= Context.SegmentCountLength.ToStringInvariant() #>ULL >> 64);
        const uint32_t h1 = (h0 + <#= Context.SegmentLength.ToStringInvariant() #>U) ^ (static_cast<uint32_t>(hash >> 18) & <#= (Context.SegmentLength - 1).ToStringInvariant() #>U);
        const uint32_t h2 = (h0 + (2U * <#= Context.SegmentLength.ToStringInvariant() #>U)) ^ (static_cast<uint32_t>(hash) & <#= (Context.SegmentLength - 1).ToStringInvariant() #>U);
        const uint32_t candidate = static_cast<uint32_t>(data[h0]) ^ static_cast<uint32_t>(data[h1]) ^ static_cast<uint32_t>(data[h2]);

        if (candidate >= <#= Data.KeyCount.ToStringInvariant() #>U) {
            value = nullptr;
            return false;
        }

        const auto& entry = entries[candidate];
        if (<#= GetEqual(LookupKeyName, "entry.key") #>) {
            value = &entry.value;
            return true;
        }

        value = nullptr;
        return false;
    }
<#
    }
#>
<#@ include file="Includes\Footer.ttinclude" #>