    public:
        explicit offset_iterator(const uint64_t offset) noexcept : _offset(offset) { advance(); }

        offset_iterator& operator++() noexcept { ++_offset; advance(); return *this; }
        [[nodiscard]] bool operator!=(const offset_iterator& other) const noexcept { return _offset != other._offset; }
