<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generators.Contexts.HashTableCompactContext" name="Context" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.HashTableCompactTemplateData" name="Data" #>

<#
    string[] valueLabels = Data.Values.Select(TypeMap.GetValueLiteral).ToArray();
    Type indexType = GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestUnsignedStorageType((ulong)Context.BucketStarts.Max()) : typeof(uint);
    Type hashType = Context.StoreHashCode && GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestUnsignedStorageType(Data.Entries.Max(x => x.Hash)) : typeof(ulong);
#>
struct E {
    key: <#= StoredKeyTypeName #>,
<#
    if (Context.StoreHashCode)
    {
#>    hash_code: <#= TypeMap.GetTypeName(hashType) #>,
<#
    }
    if (Data.ValueCount > 0)
    {
#>    value: <#= StoredValueTypeName #>,
<#
    }
#>}

<#@ include file="Includes\ImplHeader.ttinclude" #>
    <#= FieldModifier #>BUCKET_STARTS: [<#= TypeMap.GetTypeName(indexType) #>; <#= Context.BucketStarts.Length.ToStringInvariant() #>] = [
<#= FormatHelper.FormatColumns(Context.BucketStarts, (_, x) => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x, indexType)), 8) #>
    ];

    <#= FieldModifier #>ENTRIES: [E; <#= Data.Entries.Length.ToStringInvariant() #>] = [
<#= FormatHelper.FormatColumns(Data.Entries, (i, x) =>
    {
        string hashPart = Context.StoreHashCode ? $"hash_code: {TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.Hash, hashType))}, " : string.Empty;
        string valuePart = Data.ValueCount > 0 ? $", value: {valueLabels[i]}" : string.Empty;
        return $"E {{ {hashPart}key: {TypeMap.GetValueLiteral(x.Key)}{valuePart} }}";
    }, 8) #>
    ];

<#= HashSource #>

<#= EntryIterators("ENTRIES", "entry.key", "entry.value", Data.ValueCount) #>

    <#= MethodAttribute #>
    <#= MethodModifier #>fn contains(key: <#= InputKeyTypeName #>) -> bool {
<#= GetMethodHeader(MethodType.Contains) #>
        let hash = <#= HashCall #>;
        let index = (<#= GetMod("hash", (ulong)(Context.BucketStarts.Length - 1)) #>) as usize;
        let start = Self::BUCKET_STARTS[index] as usize;
        let end = Self::BUCKET_STARTS[index + 1] as usize;

        for i in start..end {
            let entry = &Self::ENTRIES[i];
            if <#
    if (Context.StoreHashCode)
    {
#>(entry.hash_code as u64) == hash && <#
    }
#><#= GetEqual("entry.key", LookupKeyName) #> {
                return true;
            }
        }

        false
    }
<#
    if (Data.ValueCount > 0)
    {
#>

    <#= MethodAttribute #>
    <#= MethodModifier #>fn try_lookup(key: <#= InputKeyTypeName #>) -> Option<<#= StoredValueTypeName #>> {
<#= GetMethodHeader(MethodType.TryLookup) #>
        let hash = <#= HashCall #>;
        let index = (<#= GetMod("hash", (ulong)(Context.BucketStarts.Length - 1)) #>) as usize;
        let start = Self::BUCKET_STARTS[index] as usize;
        let end = Self::BUCKET_STARTS[index + 1] as usize;

        for i in start..end {
            let entry = &Self::ENTRIES[i];
            if <#
        if (Context.StoreHashCode)
        {
#>(entry.hash_code as u64) == hash && <#
        }
#><#= GetEqual("entry.key", LookupKeyName) #> {
                return Some(entry.value);
            }
        }

        None
    }
<#
    }
#>
<#@ include file="Includes\Footer.ttinclude" #>