    ];
<#
    }
#>
    <#= FieldModifier #>KEYS: [<#= StoredKeyTypeName #>; <#= Data.KeyCount.ToStringInvariant() #>] = [
<#= FormatHelper.FormatColumns(Data.Keys, Data.KeyCount, TypeMap.GetValueLiteral, 8) #>
    ];

<#= ArrayAccessProperties("KEYS", "VALUES", Data.ValueCount) #>

    <#= MethodAttribute #>
    <#= MethodModifier #>fn contains(key: <#= InputKeyTypeName #>) -> bool {
<#= GetMethodHeader(MethodType.Contains) #>
        let mut lo: i32 = 0;
        let mut hi: i32 = <#= (Data.KeyCount - 1).ToStringInvariant() #>;
<# if (range != 0) { #>
        if !(<#= LookupKeyName #> >= Self::KEYS[0] && <#= LookupKeyName #> <= Self::KEYS[hi as usize]) {
            return false;
        }
        let first_offset = Self::multiply_high(<#= coordinate(LookupKeyName) #>.wrapping_sub(<#= TypeMap.GetValueLiteral(NumericPrediction.Coordinate(Data.Keys.First())) #>) << <#= 32 - shift #>, <#= TypeMap.GetValueLiteral(firstReciprocal) #>);
        let first = if first_offset > hi as u64 { hi } else { first_offset as i32 };
        let first_key = Self::KEYS[first as usize];
        if first_key == <#= LookupKeyName #> {
            return true;
        }
        if first_key < <#= LookupKeyName #> { lo = first + 1; }
        else { hi = first - 1; }
<# } #>
        while lo <= hi && <#= LookupKeyName #> >= Self::KEYS[lo as usize] && <#= LookupKeyName #> <= Self::KEYS[hi as usize] {
            let lo_key: <#= InputKeyTypeName #> = Self::KEYS[lo as usize];
            let hi_key: <#= InputKeyTypeName #> = Self::KEYS[hi as usize];

            if lo_key == hi_key {
                if lo_key == <#= LookupKeyName #> {
                    return true;
                }

                break;
            }

            let range = <#= coordinate("hi_key") #>.wrapping_sub(<#= coordinate("lo_key") #>);
            let delta = <#= coordinate(LookupKeyName) #>.wrapping_sub(<#= coordinate("lo_key") #>);
            let normalized_range = range >> <#= shift #>;
            let mid: i32;
            if normalized_range < (hi - lo) as u64 {
                mid = lo + ((hi - lo) >> 1);
            } else {
                let reciprocal = (((hi - lo) as u64) << 32) / normalized_range + 1;
                let offset = Self::multiply_high(delta << <#= 32 - shift #>, reciprocal);
                mid = if offset > (hi - lo) as u64 { hi } else { lo + offset as i32 };
            }

            let mid_key: <#= InputKeyTypeName #> = Self::KEYS[mid as usize];
            if mid_key == <#= LookupKeyName #> {
                return true;
            }
            if mid_key < <#= LookupKeyName #> {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }

        false
    }
