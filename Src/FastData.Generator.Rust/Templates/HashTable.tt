<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generators.Contexts.HashTableContext" name="Context" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.HashTableTemplateData" name="Data" #>

<#
    string[] valueLabels = Data.Values.Select(TypeMap.ToValueLabel).ToArray();
    Type bucketType = GeneratorConfig.TypeReductionEnabled ? TypeMap.GetSmallestUnsignedType((ulong)Context.Buckets.Max()) : typeof(int);
    Type nextType = GeneratorConfig.TypeReductionEnabled ? TypeMap.GetSmallestSignedType(Data.Entries.Min(x => x.Next), Data.Entries.Max(x => x.Next)) : typeof(int);
    Type hashType = Context.StoreHashCode && GeneratorConfig.TypeReductionEnabled ? TypeMap.GetSmallestUnsignedType(Data.Entries.Max(x => x.Hash)) : typeof(ulong);
#>
struct E {
    key: <#= StoredKeyTypeName #>,
<#
    if (Context.StoreHashCode)
    {
#>    hash_code: <#= TypeMap.GetTypeName(hashType) #>,
<#
    }
#>    next: <#= TypeMap.GetTypeName(nextType) #>,
<#
    if (Data.ValueCount > 0)
    {
#>    value: <#= StoredValueTypeName #>,
<#
    }
#>}

<#@ include file="Includes\ImplHeader.ttinclude" #>
    <#= FieldModifier #>BUCKETS: [<#= TypeMap.GetTypeName(bucketType) #>; <#= Context.Buckets.Length.ToStringInvariant() #>] = [
<#= FormatHelper.FormatColumns(Context.Buckets, (_, x) => TypeMap.ToValueLabel(x, bucketType), 8) #>
    ];

    <#= FieldModifier #>ENTRIES: [E; <#= Data.Entries.Length.ToStringInvariant() #>] = [
<#= FormatHelper.FormatColumns(Data.Entries, (i, x) =>
    {
        string hashPart = Context.StoreHashCode ? $"hash_code: {TypeMap.ToValueLabel(x.Hash, hashType)}, " : string.Empty;
        string valuePart = Data.ValueCount > 0 ? $", value: {valueLabels[i]}" : string.Empty;
        return $"E {{ {hashPart}next: {TypeMap.ToValueLabel(x.Next, nextType)}, key: {TypeMap.ToValueLabel(x.Key)}{valuePart} }}";
    }, 8) #>
    ];

<#= HashSource #>

<#= EntryIterators("ENTRIES", "entry.key", "entry.value", Data.ValueCount) #>

    <#= MethodAttribute #>
    <#= MethodModifier #>fn contains(key: <#= InputKeyTypeName #>) -> bool {
<#= GetMethodHeader(MethodType.Contains) #>
        let hash = <#= HashCall #>;
        let index = <#= GetMod("hash", (ulong)Context.Buckets.Length) #>;
        let mut i: i32 = (Self::BUCKETS[index as usize] as i32) - 1;

        while i >= 0 {
            let entry = &Self::ENTRIES[i as usize];
            if <#
    if (Context.StoreHashCode)
    {
#>(entry.hash_code as u64) == hash && <#
    }
#><#= GetEqual("entry.key", LookupKeyName) #> {
                return true;
            }
            i = entry.next as i32;
        }

        false
    }
<#
    if (Data.ValueCount > 0)
    {
#>

    <#= MethodAttribute #>
    <#= MethodModifier #>fn try_lookup(key: <#= InputKeyTypeName #>) -> Option<<#= StoredValueTypeName #>> {
<#= GetMethodHeader(MethodType.TryLookup) #>
        let hash = <#= HashCall #>;
        let index = <#= GetMod("hash", (ulong)Context.Buckets.Length) #>;
        let mut i: i32 = (Self::BUCKETS[index as usize] as i32) - 1;

        while i >= 0 {
            let entry = &Self::ENTRIES[i as usize];
            if <#
    if (Context.StoreHashCode)
    {
#>(entry.hash_code as u64) == hash && <#
    }
#><#= GetEqual("entry.key", LookupKeyName) #> {
                return Some(entry.value);
            }
            i = entry.next as i32;
        }

        None
    }
<#
    }
#>
<#@ include file="Includes\Footer.ttinclude" #>