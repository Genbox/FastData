<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../Imports/Library.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compat Include="@(AvailableCompats)" Exclude="StringBuilderCompat;MathFCompat" />
    <ProjectReference Include="..\FastData.Generator.Template\FastData.Generator.Template.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Templates\**\*.tt*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Templates\Rust\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyNamePrefix)FastData.Generator.Rust.TestHarness" />
  </ItemGroup>

</Project>