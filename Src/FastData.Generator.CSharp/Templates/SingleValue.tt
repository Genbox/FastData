<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.SingleValueTemplateData" name="Data" #>
<#
    string itemLabel = TypeMap.GetValueLiteral(Data.Item);
#>
<#
    if (Data.HasValue)
    {
#>

    private static readonly <#= ValueTypeName #> _storedValue = <#= TypeMap.GetValueLiteral(Data.Value) #>;
<#
    }
#>
    <#= MethodModifier #>IEnumerable<<#= KeyTypeName #>> Keys
    {
        get
        {
            yield return <#= itemLabel #>;
        }
    }
<#
    if (Data.HasValue)
    {
#>

    <#= MethodModifier #>IEnumerable<<#= ValueTypeName #>> Values
    {
        get
        {
            yield return _storedValue;
        }
    }
<#
    }
#>
    <#= MethodAttribute #>
    <#= MethodModifier #>bool Contains(<#= KeyTypeName #> key)
    {
<#= GetMethodHeader(MethodType.Contains) #>
        return <#= GetEqual(LookupKeyName, itemLabel) #>;
    }
<#
    if (Data.HasValue)
    {
#>

    <#= MethodAttribute #>
    <#= MethodModifier #>bool TryLookup(<#= KeyTypeName #> key, out <#= ValueTypeName #> value)
    {
<#= GetMethodHeader(MethodType.TryLookup) #>

        if (<#= GetEqual(LookupKeyName, itemLabel) #>)
        {
            value = _storedValue;
            return true;
        }

        value = default;
        return false;
    }
<#
    }
#>
