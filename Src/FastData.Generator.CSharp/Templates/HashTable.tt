<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generators.Contexts.HashTableContext" name="Context" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.HashTableTemplateData" name="Data" #>

<#
    string[] valueLabels = Data.Values.Select(TypeMap.GetValueLiteral).ToArray();
    Type bucketType = GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestUnsignedStorageType((ulong)Context.Buckets.Max()) : typeof(int);
    Type nextType = GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestSignedStorageType(-1, Data.Entries.Max(x => x.Next)) : typeof(int);
    Type hashType = Context.StoreHashCode && GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestUnsignedStorageType(Data.Entries.Max(x => x.Hash)) : typeof(ulong);
#>
    [StructLayout(LayoutKind.Auto)]
    private struct E
    {
        internal <#= KeyTypeName #> Key;
        internal <#= TypeMap.GetTypeName(nextType) #> Next;
    <#
    if (Context.StoreHashCode)
    {
#>    internal <#= TypeMap.GetTypeName(hashType) #> HashCode;
    <#
    }
#><#
    if (Data.ValueCount > 0)
    {
#>    internal <#= ValueTypeName #> Value;
    <#
    }
#>    internal E(<#= KeyTypeName #> key, <#= TypeMap.GetTypeName(nextType) #> next<#
    if (Context.StoreHashCode)
    {
#>, <#= TypeMap.GetTypeName(hashType) #> hashCode<#
    }
#><#
    if (Data.ValueCount > 0)
    {
#>, <#= ValueTypeName #> value<#
    }
#>)
        {
            Key = key;
            Next = next;
    <#
    if (Context.StoreHashCode)
    {
#>        HashCode = hashCode;
    <#
    }
#><#
    if (Data.ValueCount > 0)
    {
#>        Value = value;
    <#
    }
#>    }
    };

    <#= FieldModifier #><#= TypeMap.GetTypeName(bucketType) #>[] _buckets = new <#= TypeMap.GetTypeName(bucketType) #>[] {
<#= FormatHelper.FormatColumns(Context.Buckets, x => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x, bucketType)), 8) #>
    };

    <#= FieldModifier #>E[] _entries = {
<#= FormatHelper.FormatColumns(Data.Entries, (i, x) =>
    {
        string hashPart = Context.StoreHashCode ? $", {TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.Hash, hashType))}" : "";
        string valuePart = Data.ValueCount > 0 ? $", {valueLabels[i]}" : "";
        return $"new E({TypeMap.GetValueLiteral(x.Key)}, {TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.Next, nextType))}{hashPart}{valuePart})";
    }, 8) #>
    };

<#= HashSource #>

    <#= MethodModifier #>IEnumerable<<#= KeyTypeName #>> Keys
    {
        get
        {
            for (int i = 0; i < _entries.Length; i++)
                yield return _entries[i].Key;
        }
    }
<#
    if (Data.ValueCount > 0)
    {
#>

    <#= MethodModifier #>IEnumerable<<#= ValueTypeName #>> Values
    {
        get
        {
            for (int i = 0; i < _entries.Length; i++)
                yield return _entries[i].Value;
        }
    }
<#
    }
#>

    <#= MethodAttribute #>
    <#= MethodModifier #>bool Contains(<#= KeyTypeName #> key)
    {
<#= GetMethodHeader(MethodType.Contains) #>

        ulong hash = <#= HashCall #>;
        int index = (int)(<#= GetMod("hash", (ulong)Context.Buckets.Length) #>);
        int i = (int)_buckets[index] - 1;

        while (i >= 0)
        {
            ref E entry = ref _entries[i];

            if (<#
    if (Context.StoreHashCode)
    {
#>(ulong)entry.HashCode == hash && <#
    }
#><#= GetEqual("entry.Key", LookupKeyName) #>)
                return true;

            i = entry.Next;
        }

        return false;
    }
<#
    if (Data.ValueCount > 0)
    {
#>

    <#= MethodAttribute #>
    <#= MethodModifier #>bool TryLookup(<#= KeyTypeName #> key, out <#= ValueTypeName #> value)
    {
<#= GetMethodHeader(MethodType.TryLookup) #>

        ulong hash = <#= HashCall #>;
        int index = (int)(<#= GetMod("hash", (ulong)Context.Buckets.Length) #>);
        int i = (int)_buckets[index] - 1;

        while (i >= 0)
        {
            ref E entry = ref _entries[i];

            if (<#
        if (Context.StoreHashCode)
        {
#> (ulong)entry.HashCode == hash && <#
        }
#><#= GetEqual("entry.Key", LookupKeyName) #>)
            {
                value = entry.Value;
                return true;
            }

            i = entry.Next;
        }

        value = default;
        return false;
    }
<#
    }
#>
<#@ include file="Includes\Footer.ttinclude" #>