<# if (Model.KeyType == typeof(float) || Model.KeyType == typeof(double)) { #>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    private static ulong Coordinate(<#= KeyTypeName #> key)
    {
<# if (Model.KeyType == typeof(float)) { #>
        uint bits = key == 0 ? 0 : BitConverter.SingleToUInt32Bits(key);
        return (bits & 0x80000000U) != 0 ? ~bits : bits ^ 0x80000000U;
<# } else { #>
        ulong bits = key == 0 ? 0 : BitConverter.DoubleToUInt64Bits(key);
        return (bits & 0x8000000000000000UL) != 0 ? ~bits : bits ^ 0x8000000000000000UL;
<# } #>
    }
<# } #>