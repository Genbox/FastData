<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.PgmTemplateData" name="Data" #>

<#
    bool floatingKey = Model.KeyType == typeof(float) || Model.KeyType == typeof(double);
    string csharpDiffExpr = floatingKey ? "unchecked(Coordinate(key) - Coordinate({0}))" : "unchecked((ulong)key - (ulong){0})";
    bool singleSegment = Data.SegmentCount == 1;
    bool hasRecursiveLevels = Data.EpsilonRecursive > 0 && Data.LevelsOffsets.Length > 2;
    int linearSearchThreshold = 64;
    Type interceptType = !singleSegment && GeneratorConfig.TypeReductionEnabled ? IntegralTypeReducer.GetSmallestSignedStorageType(Data.Segments.Min(x => x.Intercept), Data.Segments.Max(x => x.Intercept)) : typeof(int);

    // Single-segment constants
    string segKeyConst = singleSegment ? TypeMap.GetValueLiteral(Data.Segments[0].Key) : "";
    float seg0Slope = singleSegment ? Data.Segments[0].Slope : 0;
    int seg0Intercept = singleSegment ? Data.Segments[0].Intercept : 0;

    // Slope formatting helper
    Func<float, string> formatSlope = slope => TypeMap.GetValueLiteral(NumericPrediction.Coefficient(slope));

    string staticMod = CSharpConfig.ClassType == ClassType.Static ? "static " : "";

#>
<#@ include file="Includes\NumericPrediction.ttinclude" #>
<#
    if (Data.ValueCount > 0)
    {
#>
    <#= FieldModifier #><#= ValueTypeName #>[] _values = {
<#= FormatHelper.FormatColumns(Data.Values, Data.ValueCount, TypeMap.GetValueLiteral, 8) #>
    };

<#
    }
#>
    <#= FieldModifier #><#= KeyTypeName #>[] _keys = new <#= KeyTypeName #>[] {
<#= FormatHelper.FormatColumns(Data.Keys, Data.KeyCount, TypeMap.GetValueLiteral, 8) #>
    };

<#= ArrayAccessProperties("_keys", "_values", Data.ValueCount) #>
<#
    // Only emit segment arrays when there are multiple segments
    if (!singleSegment)
    {
#>

    <#= FieldModifier #><#= KeyTypeName #>[] _segKeys = new <#= KeyTypeName #>[] {
<#= FormatHelper.FormatColumns(Data.Segments.Select(s => s.Key), Data.Segments.Length, TypeMap.GetValueLiteral, 8) #>
    };

    <#= FieldModifier #>ulong[] _segSlopes = new ulong[] {
<#= FormatHelper.FormatColumns(Data.Segments.Select(s => (object)s.Slope), Data.Segments.Length, o => formatSlope((float)o), 8) #>
    };

    <#= FieldModifier #><#= TypeMap.GetTypeName(interceptType) #>[] _segIntercepts = new <#= TypeMap.GetTypeName(interceptType) #>[] {
<#= FormatHelper.FormatColumns(Data.Segments, x => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.Intercept, interceptType)), 8) #>
    };
<#
    }

    // Only emit helpers when there are multiple segments
    if (!singleSegment)
    {
#>

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    private <#= staticMod #>int EvaluateSegment(int seg, <#= KeyTypeName #> key)
    {
        ulong diff = <#= string.Format(csharpDiffExpr, "_segKeys[seg]") #>;
        ulong product = Math.BigMul(_segSlopes[seg], diff, out _);
        int intercept = (int)_segIntercepts[seg];
        int maxProduct = <#= Data.KeyCount.ToStringInvariant() #> - intercept;
        return (product > (ulong)maxProduct ? maxProduct : (int)product) + intercept;
    }

    private <#= staticMod #>int GetSegmentPos(<#= KeyTypeName #> key)
    {
<#
        if (!hasRecursiveLevels)
        {
#>
        int seg = 0;
        int segHi = <#= (Data.SegmentCount - 1).ToStringInvariant() #>;
        while (seg < segHi)
        {
            int mid = seg + ((segHi - seg) >> 1);
            if (_segKeys[mid + 1] <= key)
                seg = mid + 1;
            else
                segHi = mid;
        }

        int pos = EvaluateSegment(seg, key);
        int nextIntercept = (int)_segIntercepts[seg + 1];
        if (pos > nextIntercept) pos = nextIntercept;
        return pos;
<#
        }
        else
        {
            int rootSegOffset = Data.LevelsOffsets[Data.LevelsOffsets.Length - 2];
#>
        int seg = <#= rootSegOffset.ToStringInvariant() #>;
<#
            for (int level = Data.LevelsOffsets.Length - 3; level >= 0; level--)
            {
                int levelBegin = Data.LevelsOffsets[level];
                int levelEnd = Data.LevelsOffsets[level + 1];
                int levelSize = levelEnd - levelBegin - 1;
                int sentinel = levelEnd - 1;
                int epsRec = Data.EpsilonRecursive + 1;
                bool useBinarySearch = epsRec > linearSearchThreshold;
#>

        {
            int pos = EvaluateSegment(seg, key);
            int nextIntercept = (int)_segIntercepts[seg + 1];
            if (pos > nextIntercept) pos = nextIntercept;

            int lo = pos - <#= (epsRec + 1).ToStringInvariant() #>;
            if (lo < 0) lo = 0;
<#
                if (useBinarySearch)
                {
#>

            int hi = pos + <#= (epsRec + 2).ToStringInvariant() #>;
            if (hi > <#= levelSize.ToStringInvariant() #>) hi = <#= levelSize.ToStringInvariant() #>;

            seg = <#= levelBegin.ToStringInvariant() #> + lo;
            int segHi = <#= levelBegin.ToStringInvariant() #> + hi;
            while (seg < segHi)
            {
                int mid = seg + ((segHi - seg) >> 1);
                if (_segKeys[mid + 1] <= key)
                    seg = mid + 1;
                else
                    segHi = mid;
            }
<#
                }
                else
                {
#>

            seg = <#= levelBegin.ToStringInvariant() #> + lo;
            while (seg + 1 < <#= sentinel.ToStringInvariant() #> && _segKeys[seg + 1] <= key)
                seg++;
<#
                }
#>
        }
<#
            }
#>

        {
            int pos = EvaluateSegment(seg, key);
            int nextIntercept = (int)_segIntercepts[seg + 1];
            if (pos > nextIntercept) pos = nextIntercept;
            return pos;
        }
<#
        }
#>
    }
<#
    }
#>

    <#= MethodAttribute #>
    <#= MethodModifier #>bool Contains(<#= KeyTypeName #> key)
    {
<#= GetMethodHeader(MethodType.Contains) #>
        if (!(<#= LookupKeyName #> >= _keys[0] && <#= LookupKeyName #> <= _keys[<#= (Data.KeyCount - 1).ToStringInvariant() #>]))
        {
            return false;
        }

<#
    if (singleSegment)
    {
#>
<#
        if (seg0Slope == 0)
        {
            // Slope is zero: position is just the intercept, clamped to [0, n]
#>
        int pos = <#= seg0Intercept.ToStringInvariant() #>;
<#
        }
        else
        {
#>
        ulong diff = <#= string.Format(csharpDiffExpr, segKeyConst) #>;
        ulong product = Math.BigMul(<#= formatSlope(seg0Slope) #>, diff, out _);
        int pos = product > <#= (Data.KeyCount - seg0Intercept).ToStringInvariant() #>UL ? <#= (Data.KeyCount - seg0Intercept).ToStringInvariant() #> : (int)product;
<#          if (seg0Intercept != 0) { #>
        pos += <#= seg0Intercept.ToStringInvariant() #>;
<#          } #>
<#
        }
#>

        int lo = pos - <#= (Data.Epsilon + 1).ToStringInvariant() #>;
        if (lo < 0) lo = 0;
        int hi = pos + <#= (Data.Epsilon + 3).ToStringInvariant() #>;
        if (hi > <#= Data.KeyCount.ToStringInvariant() #>) hi = <#= Data.KeyCount.ToStringInvariant() #>;

        while (lo < hi)
        {
            int i = lo + ((hi - lo) >> 1);
            if (_keys[i] == <#= LookupKeyName #>)
                return true;
            if (_keys[i] < <#= LookupKeyName #>)
                lo = i + 1;
            else
                hi = i;
        }

        return false;
<#
    }
    else
    {
        // Multi-segment path
#>
        int pos = GetSegmentPos(<#= LookupKeyName #>);

        int lo = pos - <#= (Data.Epsilon + 1).ToStringInvariant() #>;
        if (lo < 0) lo = 0;
        int hi = pos + <#= (Data.Epsilon + 3).ToStringInvariant() #>;
        if (hi > <#= Data.KeyCount.ToStringInvariant() #>) hi = <#= Data.KeyCount.ToStringInvariant() #>;

        while (lo < hi)
        {
            int i = lo + ((hi - lo) >> 1);
            if (_keys[i] == <#= LookupKeyName #>)
                return true;
            if (_keys[i] < <#= LookupKeyName #>)
                lo = i + 1;
            else
                hi = i;
        }

        return false;
<#
    }
#>
    }
<#
    if (Data.ValueCount > 0)
    {
#>

    <#= MethodAttribute #>
    <#= MethodModifier #>bool TryLookup(<#= KeyTypeName #> key, out <#= ValueTypeName #> value)
    {
<#= GetMethodHeader(MethodType.TryLookup) #>
        if (!(<#= LookupKeyName #> >= _keys[0] && <#= LookupKeyName #> <= _keys[<#= (Data.KeyCount - 1).ToStringInvariant() #>]))
        {
            value = default;
            return false;
        }

<#
        if (singleSegment)
        {
#>
<#
            if (seg0Slope == 0)
            {
#>
        int pos = <#= seg0Intercept.ToStringInvariant() #>;
<#
            }
            else
            {
#>
        ulong diff = <#= string.Format(csharpDiffExpr, segKeyConst) #>;
        ulong product = Math.BigMul(<#= formatSlope(seg0Slope) #>, diff, out _);
        int pos = product > <#= (Data.KeyCount - seg0Intercept).ToStringInvariant() #>UL ? <#= (Data.KeyCount - seg0Intercept).ToStringInvariant() #> : (int)product;
<#              if (seg0Intercept != 0) { #>
        pos += <#= seg0Intercept.ToStringInvariant() #>;
<#              } #>
<#
            }
#>

        int lo = pos - <#= (Data.Epsilon + 1).ToStringInvariant() #>;
        if (lo < 0) lo = 0;
        int hi = pos + <#= (Data.Epsilon + 3).ToStringInvariant() #>;
        if (hi > <#= Data.KeyCount.ToStringInvariant() #>) hi = <#= Data.KeyCount.ToStringInvariant() #>;

        while (lo < hi)
        {
            int i = lo + ((hi - lo) >> 1);
            if (_keys[i] == <#= LookupKeyName #>)
            {
                value = _values[i];
                return true;
            }
            if (_keys[i] < <#= LookupKeyName #>)
                lo = i + 1;
            else
                hi = i;
        }

        value = default;
        return false;
<#
        }
        else
        {
#>
        int pos = GetSegmentPos(<#= LookupKeyName #>);

        int lo = pos - <#= (Data.Epsilon + 1).ToStringInvariant() #>;
        if (lo < 0) lo = 0;
        int hi = pos + <#= (Data.Epsilon + 3).ToStringInvariant() #>;
        if (hi > <#= Data.KeyCount.ToStringInvariant() #>) hi = <#= Data.KeyCount.ToStringInvariant() #>;

        while (lo < hi)
        {
            int i = lo + ((hi - lo) >> 1);
            if (_keys[i] == <#= LookupKeyName #>)
            {
                value = _values[i];
                return true;
            }
            if (_keys[i] < <#= LookupKeyName #>)
                lo = i + 1;
            else
                hi = i;
        }

        value = default;
        return false;
<#
        }
#>
    }
<#
    }
#>
<#@ include file="Includes\Footer.ttinclude" #>