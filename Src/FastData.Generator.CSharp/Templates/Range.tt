<#@ include file="Includes\Header.ttinclude" #>
<#@ parameter type="Genbox.FastData.Generator.Template.TemplateData.RangeTemplateData" name="Data" #>

<#
    Type rangeType = GeneratorConfig.TypeReductionEnabled && Data.RangeCount > 1
        ? IntegralTypeReducer.GetSmallestStorageType(Model.KeyType, Data.Ranges[0].Start, Data.Ranges[^1].End)
        : Model.KeyType;
    string rangeTypeName = TypeMap.GetTypeName(rangeType);
    bool rangeTypeReduced = rangeType != Model.KeyType;
    Func<string, string> toKeyType = value => rangeTypeReduced ? $"({KeyTypeName}){value}" : value;

    if (Data.RangeCount > 1)
    {
#>
    <#= FieldModifier #><#= rangeTypeName #>[] _rangeStarts = new <#= rangeTypeName #>[] {
<#= FormatHelper.FormatColumns(Data.Ranges, x => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.Start, rangeType)), 8) #>
    };

    <#= FieldModifier #><#= rangeTypeName #>[] _rangeEnds = new <#= rangeTypeName #>[] {
<#= FormatHelper.FormatColumns(Data.Ranges, x => TypeMap.GetValueLiteral(IntegralValueConverter.ConvertChecked(x.End, rangeType)), 8) #>
    };
<#
    }
#>
    <#= MethodModifier #>IEnumerable<<#= KeyTypeName #>> Keys
    {
        get
        {
<#
    if (Data.RangeCount == 1)
    {
#>            for (<#= KeyTypeName #> key = <#= TypeMap.GetValueLiteral(Data.Ranges[0].Start) #>; ; key++)
            {
                yield return key;

                if (key == <#= TypeMap.GetValueLiteral(Data.Ranges[0].End) #>)
                    break;
            }
<#
    }
    else
    {
#>            for (int i = 0; i < _rangeStarts.Length; i++)
            {
                for (<#= KeyTypeName #> key = <#= toKeyType("_rangeStarts[i]") #>; ; key++)
                {
                    yield return key;

                    if (key == <#= toKeyType("_rangeEnds[i]") #>)
                        break;
                }
            }
<#
    }
#>        }
    }

    <#= MethodAttribute #>
    <#= MethodModifier #>bool Contains(<#= KeyTypeName #> key)
    {
<#= GetMethodHeader(MethodType.Contains) #>

<#
    if (Data.RangeCount == 1)
    {
#>
        return <#= LookupKeyName #> >= <#= TypeMap.GetValueLiteral(Data.Ranges[0].Start) #> && <#= LookupKeyName #> <= <#= TypeMap.GetValueLiteral(Data.Ranges[0].End) #>;
<#
    }
    else if (Data.RangeCount < 8)
    {
#>
        for (int i = 0; i < <#= Data.RangeCount.ToStringInvariant() #>; i++)
        {
            if (<#= LookupKeyName #> < <#= toKeyType("_rangeStarts[i]") #>)
                return false;

            if (<#= LookupKeyName #> <= <#= toKeyType("_rangeEnds[i]") #>)
                return true;
        }

        return false;
<#
    }
    else
    {
#>
        int low = 0;
        int high = <#= Data.RangeCount.ToStringInvariant() #>;

        while (low < high)
        {
            int middle = low + ((high - low) >> 1);

            if (<#= LookupKeyName #> < <#= toKeyType("_rangeStarts[middle]") #>)
                high = middle;
            else
                low = middle + 1;
        }

        int rangeIndex = low - 1;
        return rangeIndex >= 0 && <#= LookupKeyName #> <= <#= toKeyType("_rangeEnds[rangeIndex]") #>;
<#
    }
#>
    }
<#@ include file="Includes\Footer.ttinclude" #>