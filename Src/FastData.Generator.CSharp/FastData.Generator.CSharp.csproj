<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../Imports/Library.props" />

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0; net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <Compat Include="@(AvailableCompats)" Exclude="StringBuilderCompat;MathFCompat" />
    <ProjectReference Include="..\FastData.Generator.Template\FastData.Generator.Template.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Templates\**\*.tt*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Templates\CSharp\%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyNamePrefix)FastData.Testbed" />
    <InternalsVisibleTo Include="$(AssemblyNamePrefix)FastData.Generator.CSharp.TestHarness" />
  </ItemGroup>

</Project>